# Copiar a .env (en la raíz del repo) y completar los valores antes de levantar el stack.
# RNF-06: este archivo no contiene credenciales reales.
# Generar claves, por ejemplo, con: openssl rand -base64 32

COMPOSE_PROJECT_NAME=m3

# PostgreSQL - superusuario (solo para la inicialización)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Base propia de M3 (RNF-05)
M3_DB_NAME=m3
M3_DB_USER=m3
M3_DB_PASSWORD=

# Base propia de Keycloak (RNF-05)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=m3
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_M3_CLIENT_ID=m3-api
KEYCLOAK_M3_CLIENT_SECRET=
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Usuarios de prueba del realm
M3_OPERADOR_USERNAME=operador.m3
M3_OPERADOR_PASSWORD=
M3_CONDUCTOR_USERNAME=conductor.m3
M3_CONDUCTOR_PASSWORD=
# Cuenta tecnica de M4 (rol servicio, solo lectura)
M3_SERVICIO_USERNAME=servicio.m4
M3_SERVICIO_PASSWORD=

# API
API_PORT=8080
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
RATE_LIMIT_HMAC_SECRET=
RATE_LIMIT_ANON_REQUESTS=60
RATE_LIMIT_PREAUTH_REQUESTS=1000
RATE_LIMIT_AUTH_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Se compone dentro del compose; también puede usarse para ejecutar la API
# contra un PostgreSQL local.
DATABASE_URL=postgresql+psycopg://${M3_DB_USER}:${M3_DB_PASSWORD}@postgres:5432/${M3_DB_NAME}
LOG_LEVEL=INFO
# Ubicación simulada que M3 asigna cuando el conductor sale de DESCONECTADO sin
# informar la suya. Opcionales: la API usa estos mismos valores por defecto.
UBICACION_SIMULADA_LATITUD=-27.4511
UBICACION_SIMULADA_LONGITUD=-58.9867

# Frontend (Next.js). Usa las credenciales de Keycloak y del conductor de prueba de arriba.
FRONTEND_PORT=3000
