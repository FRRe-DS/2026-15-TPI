# ─── Modo mock ────────────────────────────────────────────────────────────────
# true  → usa datos ficticios de src/mocks/conductores.mock.ts (sin backend)
# false → llama a la API real con autenticación Keycloak (requiere stack levantado)
USE_MOCK=false

# ─── API ───────────────────────────────────────────────────────────────────────
API_URL=

# ─── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ─── Usuario de prueba (password grant) ───────────────────────────────────────
TEST_USER=
TEST_PASSWORD=
